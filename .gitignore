.env
.env.*
!.env.example
__pycache__/
evals/probes/private/
.venv/
.pytest_cache/
*.pyc
apps/api/demo_data/
# recorded Meta API traffic (model output; may reflect your photos). Force-add a reviewed file only on purpose.
apps/api/demo_data/recordings/
evals/recordings/
# eval reports: `git add -f` a report you want to keep as evidence
evals/reports/*
!evals/reports/.gitkeep

# Generated eval photos: commit only the base photo; scripts/make_generated.py rebuilds the gen-*.png layouts from it.
evals/photos/generated/*.png
!evals/photos/generated/gen-base.png
